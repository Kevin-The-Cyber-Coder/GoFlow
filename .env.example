# Copy this file to .env before running `docker compose up`.
# Docker Compose reads .env automatically from the repository root.

# --- Application -----------------------------------------------------------
NODE_ENV=development

# Host ports. Change these if something else already listens on them.
API_PORT=3000
WEB_PORT=5173

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=goflow
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=goflow
POSTGRES_PORT=5432

# Used by the API. Inside Compose the host is the service name `postgres`;
# from a host process it is `localhost`.
DATABASE_URL=postgresql://goflow:local-development-only@localhost:5432/goflow

# --- Authentication --------------------------------------------------------
# HS256 signing key for access tokens. At least 32 characters, and it must be
# unique per environment: rotating it invalidates every issued access token.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-characters

# Access tokens are short-lived and renewed with the refresh cookie.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
