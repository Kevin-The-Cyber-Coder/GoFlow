# Copy this file to `.env` in the repository root.
#
# Docker Compose reads it automatically. Without Docker, `npm run dev:api` and
# `npm run dev:web` do not load it for you: export the values in your shell, or
# run the API with `node --env-file=.env` / use `direnv`. Never commit `.env`.

# --- Application -----------------------------------------------------------

# development | test | production
# In production the API refuses to start without a real JWT_ACCESS_SECRET.
NODE_ENV=development

# Port the API listens on when it runs as a host process (`npm run dev:api`).
# Inside Docker the process always listens on 3000 and API_PORT only maps the
# host side, so the two variables are deliberately separate.
PORT=3000

# --- PostgreSQL ------------------------------------------------------------

POSTGRES_USER=goflow
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=goflow

# Host port published by the Compose `postgres` service.
POSTGRES_PORT=5432

# Connection string used by the API and by Prisma.
# - Host process: `localhost` and POSTGRES_PORT as above.
# - Inside Compose: host `postgres`, port 5432 (the container port, not
#   POSTGRES_PORT).
DATABASE_URL=postgresql://goflow:local-development-only@localhost:5432/goflow

# --- Authentication --------------------------------------------------------

# HMAC secret for access tokens. Required in production, minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Development falls back to a fixed value, which is exactly why it must never
# be relied on outside development.
JWT_ACCESS_SECRET=

# Access token lifetime, in seconds. Short by design: the refresh session is the
# long-lived credential.
JWT_ACCESS_TTL_SECONDS=900

# Refresh session lifetime, in days.
REFRESH_TTL_DAYS=30

# Password reset token lifetime, in minutes.
PASSWORD_RESET_TTL_MINUTES=60

# --- Reverse proxy ---------------------------------------------------------

# Set to 1 when the API sits behind exactly one trusted proxy (nginx, a PaaS
# router). This makes Express read the client IP from X-Forwarded-For, which
# rate limiting and audit rows depend on. Leave unset when the API is directly
# reachable, otherwise a client can forge its own IP.
TRUST_PROXY=

# --- Docker Compose host ports --------------------------------------------

# Host ports for the two published services. Change these when something else
# already listens on 3000 or 5173.
API_PORT=3000
WEB_PORT=5173

# --- Web dev server --------------------------------------------------------

# Where the Vite dev server proxies `/api`. Defaults to the host process.
# Compose overrides this with `http://api:3000` because the container cannot
# reach the host as `localhost`.
VITE_API_PROXY_TARGET=http://localhost:3000

# --- Local development database (npm run db:dev) ---------------------------

# Port the embedded PostgreSQL listens on and where it keeps its data.
# Defaults: 55432 and ~/.goflow/postgres.
DEV_DATABASE_PORT=55432
DEV_DATABASE_DIR=
